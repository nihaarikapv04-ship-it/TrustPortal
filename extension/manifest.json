{
  "manifest_version": 3,
  "name": "TrustPortal — TSIF Accessibility Trust Gate",
  "version": "1.0.0",
  "description": "Statistically calibrated, injection-resistant runtime accessibility repair framework.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TrustPortal TSIF Active"
  }
}
